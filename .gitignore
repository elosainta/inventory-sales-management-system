# Obsidian's per-machine UI state — which tabs and panes you had open. Rewrites
# itself constantly and differs per clone, so it would only ever conflict. The
# rest of .obsidian/ (enabled core plugins, graph settings) IS shared.
/docs/vault/.obsidian/workspace.json
/docs/vault/.obsidian/workspace-mobile.json

# Off-box backup credentials (scripts/backup/push-offsite.sh). The real file
# lives on the droplet; this guard stops a filled-in copy being committed.
offsite.env
